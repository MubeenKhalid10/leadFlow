# -----------------------------------------------------------------------------
# LeadFlow database connection — EXAMPLE
# -----------------------------------------------------------------------------
# Copy this file to  .streamlit/secrets.toml  and fill in your real values.
# The real secrets.toml is git-ignored so credentials never get committed.
#
# Local PostgreSQL example:
#   host = "localhost", port = "5432", dbname = "leadflow",
#   user = "postgres",  password = "your-local-password"
#
# Cloud PostgreSQL (e.g. Neon / Supabase) example:
#   host = "ep-xxxx.eu-central-1.aws.neon.tech"
#   port = "5432"
#   dbname = "leadflow"
#   user = "leadflow_user"
#   password = "••••••••"
#   sslmode = "require"        # some cloud providers require SSL
# -----------------------------------------------------------------------------

[postgres]
host = "aws-0-ap-southeast-1.pooler.supabase.com"
port = "6543"
dbname = "postgres"
user = "postgres.uuuehtnrscbraubblynz"
password = "leadFlow@1122"
sslmode = "require"