# LeadFlow — environment variables for Docker / AWS
# Copy to .env for local Docker runs (docker run --env-file .env ...). Never commit .env.
# In AWS, inject these from Secrets Manager / SSM into the ECS task (or EC2 instance).
#
# Precedence: Streamlit secrets (.streamlit/secrets.toml) are used when present
# (local development); these variables are the fallback for the Supabase settings
# and override secrets for the PostgreSQL settings.

# --- Supabase Auth (authentication + profiles/roles only; unchanged by the move to RDS)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=YOUR-SUPABASE-ANON-KEY

# --- PostgreSQL (AWS RDS). Local: PG_HOST=localhost. AWS: the RDS endpoint.
PG_HOST=
PG_PORT=5432
PG_DATABASE=leadflow
PG_USER=
PG_PASSWORD=
# RDS requires TLS. Use "disable" only for a local PostgreSQL without SSL.
PGSSLMODE=require

# --- Storage quota: allocated RDS storage in MB (e.g. 20 GB = 20480).
# Drives the "Available Storage" metric on the Database page. Optional; when
# missing the metric shows "Not configured" and everything else works.
PG_STORAGE_QUOTA_MB=20480
